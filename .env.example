# ============================================================
# Serveur
# ============================================================
NODE_ENV=development
PORT=3000
# URL publique du backend, utilisée pour construire les URLs absolues des
# fichiers uploadés (images produits, logos, pièces jointes, etc.).
APP_URL=http://localhost:3000
# Identifiant d'instance pour les leases de cron multi-instances (optionnel).
# Si vide, HOSTNAME est utilisé.
INSTANCE_ID=

# ============================================================
# Base de données
# ============================================================
MONGODB_URI=mongodb://127.0.0.1:27017/eat

# ============================================================
# Authentification / chiffrement
# ============================================================
JWT_SECRET=change-me-access-secret
# Actuellement non utilisé : les access tokens sont signés avec JWT_SECRET.
# Conservé (commenté) pour compatibilité avec les anciens .env.
# JWT_REFRESH_SECRET=change-me-refresh-secret
GOOGLE_CLIENT_ID=
# Si vide, JWT_SECRET est utilisé comme clé de chiffrement (fallback).
ENCRYPTION_KEY=

# ============================================================
# CORS
# ============================================================
# URL exacte du frontend (sans slash final). Obligatoire en production.
FRONTEND_URL=http://localhost:4200
# Origines supplémentaires (www, préprod, autre port local), séparées par des virgules.
CORS_ORIGINS=

# ============================================================
# Emails (reset password, notifications, annonces)
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESET_PASSWORD_PATH=/reset-password

# ============================================================
# Paiement mobile money (DigiKuntz)
# ============================================================
DIGIKUNTZ_BASE_URL=
DIGIKUNTZ_USER_ID=
DIGIKUNTZ_API_KEY=
DIGIKUNTZ_WEBHOOK_SECRET=
# Timeout d'un appel HTTP DigiKuntz (ms). Au-delà, l'issue est inconnue.
DIGIKUNTZ_REQUEST_TIMEOUT_MS=12000
# Timeout avant alerte/réconciliation manuelle d'un retrait gateway indisponible (ms).
DIGIKUNTZ_GATEWAY_TIMEOUT_MS=3600000
# Timeout du direct charge (push opérateur) en ms.
DIGIKUNTZ_DIRECT_CHARGE_TIMEOUT_MS=20000
# Intervalle minimal entre deux tentatives de payout (ms).
DIGIKUNTZ_RETRY_INTERVAL_MS=60000
# TTL d'idempotence provider : au-delà, plus de retry automatique (ms).
# Doit rester STRICTEMENT sous la TTL réelle de 24 h (marge de sécurité).
DIGIKUNTZ_IDEMPOTENCY_TTL_MS=82800000
# Délai minimal avant de renvoyer la même demande après une issue inconnue (s).
PAYMENT_UNKNOWN_RETRY_COOLDOWN_SECONDS=60
# Durée maximale de retenue d'une commande dont le direct charge est unknown (min).
PAYMENT_UNKNOWN_HOLD_MINUTES=30
# Durée maximale de retenue d'un appel direct "calling" (min).
PAYMENT_DIRECT_CALLING_HOLD_MINUTES=2
# Solde minimum strict pour déclencher un retrait automatique restaurant (XAF).
MIN_WITHDRAWAL_AMOUNT_XAF=1000
# URL à configurer côté DigiKuntz > Clés API > webhookUrl :
# ${APP_URL}/webhook/digikuntz

# Paiement mobile money direct : codes USSD de confirmation affichés au client.
# Valeur entre guillemets (le caractère # sinon commenterait la ligne).
# Variable absente → valeur par défaut ; variable vide → aucun code affiché.
MOBILE_MONEY_USSD_ORANGE="#150*50#"
MOBILE_MONEY_USSD_MTN="*126#"

# ============================================================
# Commandes / répartition
# ============================================================
# TTL d'une commande en attente de paiement, et fenêtre du lien hébergé de secours (min).
ORDER_PAYMENT_TIMEOUT_MINUTES=30
# Alias legacy de ORDER_PAYMENT_TIMEOUT_MINUTES (déprécié, gardé en fallback).
PAYMENT_TIMEOUT_MINUTES=
PAYMENT_HOSTED_FALLBACK_TIMEOUT_MINUTES=30
PLATFORM_FEE_TYPE=fixed
PLATFORM_FEE_VALUE=0

# ============================================================
# Batchs et verrous (exploitation)
# ============================================================
# Throttle du rafraîchissement du statut provider déclenché par le polling client (s).
PAYMENT_STATUS_SYNC_SECONDS=10
# Verrou anti-course sur l'initiation d'un paiement (s).
PAYMENT_INITIATION_LOCK_SECONDS=300
# Nombre max de commandes expirées traitées par passage de cron.
PAYMENT_EXPIRY_BATCH_LIMIT=200
# Nombre max de paiements/retraits synchronisés par passage de cron.
DIGIKUNTZ_SYNC_BATCH_LIMIT=100
# Nombre max de transactions de balance réconciliées par passage de cron.
BALANCE_RECONCILIATION_BATCH_LIMIT=100

# ============================================================
# Fichiers
# ============================================================
STORAGE_DRIVER=local
UPLOAD_DIR_LOCAL=uploads
# En production uniquement : chemin absolu du dossier d'uploads
# (ex. Hostinger : /home/u505661520/public_html/uploads).
UPLOAD_DIR=

# ============================================================
# WhatsApp
# ============================================================
# Dossier de session à conserver entre les redéploiements si vous ne voulez pas rescanner le QR code.
WHATSAPP_AUTO_INIT=true
WHATSAPP_SESSION_DIR=whatsapp-session
# Si renseigné (et WHATSAPP_LOCAL_ENABLED != true), la passerelle HTTP est utilisée.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_PASSWORD=123Whatsapp?
# true = utilise whatsapp-web.js en local au lieu de la passerelle HTTP.
WHATSAPP_LOCAL_ENABLED=false
# Délai d'attente avant que le client whatsapp-web.js soit prêt (ms).
WHATSAPP_READY_TIMEOUT_MS=90000

# ============================================================
# Merlin IA (OpenRouter)
# ============================================================
MERLIN_ENABLED=true
# Obtenez votre clé sur https://openrouter.ai/keys — obligatoire si MERLIN_ENABLED=true.
MERLIN_API_KEY=
MERLIN_BASE_URL=https://openrouter.ai/api/v1
MERLIN_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,deepseek/deepseek-v4-flash-0731:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free
# Alias legacy de MERLIN_MODELS : un seul modèle.
MERLIN_MODEL=
MERLIN_MODEL_STRATEGY=fallback
MERLIN_TEMPERATURE=0.7
MERLIN_REASONING_EFFORT=low
MERLIN_TIMEOUT_MS=90000
MERLIN_CONTEXT_MESSAGES=10
MERLIN_MAX_HISTORY=50
MERLIN_CRON_TIMEZONE=Africa/Douala

# ============================================================
# Annonces
# ============================================================
# Nombre de destinataires traités par passage du cron (toutes les 15 secondes).
ANNOUNCEMENT_DELIVERY_MAX_ATTEMPTS=3
ANNOUNCEMENT_DELIVERY_LOCK_TIMEOUT_MINUTES=10
# Legacy non utilisés par le code actuel (conservés pour compatibilité).
# ANNOUNCEMENT_EMAIL_BATCH_SIZE=100
# ANNOUNCEMENT_WHATSAPP_BATCH_SIZE=10

# ============================================================
# Divers
# ============================================================
# Version des CGU acceptée par défaut lors de l'inscription.
TERMS_VERSION=v1.0
